{
  "name": "ckb-farm-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "deploy:devnet": "tsx scripts/deploy.ts",
    "upgrade": "tsx scripts/upgrade.ts",
    "upgrade:testnet": "tsx scripts/upgrade.ts --network testnet",
    "key:new": "tsx scripts/key.ts new",
    "key:info": "tsx scripts/key.ts",
    "deploy:pages": "npm run build && wrangler pages deploy dist --project-name qq-farm --branch main",
    "bots": "tsx scripts/bots.ts",
    "e2e": "tsx scripts/e2e.ts"
  },
  "dependencies": {
    "@ckb-ccc/ccc": "^1.3.8",
    "@ckb-ccc/connector-react": "^2.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  }
}
